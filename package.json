{
  "name": "call-center-2026",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @call-center/frontend",
    "build": "npm run build --workspace @call-center/frontend",
    "start": "npm run start --workspace @call-center/frontend",
    "lint": "npm run lint --workspace @call-center/frontend",
    "typecheck": "npm run typecheck --workspace @call-center/frontend",
    "test": "npm run test --workspace @call-center/frontend",
    "test:journey": "npm run test:journey --workspace @call-center/frontend",
    "contract:check": "node packages/shared/validate-openapi.mjs",
    "benchmark:api": "python -m apps.api.benchmark",
    "smoke:containers": "sh infra/smoke-test.sh",
    "test:pinned-actions": "sh .github/workflows/test-pinned-actions.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "railway": "^3.11.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
